# ---------------------------------------------------------------------------
# Docs2Chat configuration. Copy to .env and edit. Everything is optional:
# with no changes the app runs self-hosted, free and unlimited, without AI keys
# (answers come straight from your FAQ / documents).
# ---------------------------------------------------------------------------

# Public address of this server (used in the embed code and Telegram webhook).
PUBLIC_URL=http://localhost:8000
BRAND_NAME=Docs2Chat
# Long random string. If empty, one is generated and stored in the data volume.
SECRET_KEY=

# --- AI provider: anthropic | openai | ollama | none -------------------------
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Any OpenAI-compatible API works (Groq, Together, OpenRouter, vLLM, ...)
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1

# Optional semantic search boost: openai | ollama | none
EMBEDDINGS_PROVIDER=none
EMBEDDINGS_MODEL=

# --- Telegram handoff ---------------------------------------------------------
# Create a bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=
# polling (works everywhere, no public URL needed) | webhook (needs HTTPS PUBLIC_URL) | off
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=

# --- Accounts -------------------------------------------------------------------
# Set to false after creating your own account on a private server.
SIGNUP_ENABLED=true
# Comma separated emails that can see the Platform page (all customers, manual plans).
# Empty = the first registered user.
SUPERADMIN_EMAILS=

# --- Hosted / paid version (leave false for self-hosting) ------------------------
BILLING_ENABLED=false
# Show the marketing landing page at "/" (defaults to BILLING_ENABLED)
LANDING_ENABLED=
# Key of a workspace whose widget is shown on the landing page as a live demo
DEMO_WIDGET_KEY=
# "Powered by" link in the widget (removed on Pro/Business in hosted mode)
SHOW_BADGE=true
BADGE_URL=https://github.com/tengotengo23/AI-Support-Chatbot-Knowledge-Base-Widget
# Shown on /legal (Terms, Privacy, Refunds; Paddle requires these pages) and to customers
LEGAL_NAME=
CONTACT_EMAIL=
# Free Pro trial for new sign-ups (days, 0 = off). Falls back to Free when it ends.
TRIAL_DAYS=0

# Bank-transfer invoices (Platform page -> "Invoice"; printable at /invoice/<id>)
SELLER_TAX_ID=
SELLER_ADDRESS=
SELLER_BANK=
SELLER_IBAN=
INVOICE_PREFIX=INV
INVOICE_DUE_DAYS=7

# Optional, transparent success fee on leads marked "Won" (shown to customers). 0 = off.
PLATFORM_FEE_PERCENT=0

# Paddle Billing (merchant of record; works for sellers in Georgia)
PADDLE_ENV=sandbox
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_STARTER=
PADDLE_PRICE_PRO=
PADDLE_PRICE_BUSINESS=

# --- Limits -----------------------------------------------------------------------
MAX_UPLOAD_MB=20
MAX_CRAWL_PAGES=30
WIDGET_RATE_LIMIT_PER_MINUTE=20
# Allow importing pages from private networks (only for trusted self-hosted installs)
ALLOW_PRIVATE_URLS=false
# Behind a reverse proxy (Caddy/Nginx) on the same Docker network, trust its X-Forwarded-For
FORWARDED_ALLOW_IPS=127.0.0.1
